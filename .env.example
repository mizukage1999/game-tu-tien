# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are public (they ship in the browser bundle); never put the
# service_role key here — the client never needs it.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Without these two variables the game builds and runs exactly as before: offline,
# with progress only in localStorage.
