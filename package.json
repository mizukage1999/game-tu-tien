{
  "name": "tu-tien-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-runtime-assets.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "build:android": "node scripts/verify-runtime-assets.mjs && tsc -b && vite build --mode android && node scripts/stage-android-assets.mjs",
    "android:sync": "npm run build:android && cap sync android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-icons.ps1",
    "test": "vitest run",
    "lint": "eslint .",
    "leaderboard:generate": "node scripts/generate-leaderboard-sql.mjs",
    "leaderboard:verify": "node scripts/verify-leaderboard-sql.mjs",
    "player-access:generate": "node scripts/generate-player-access-sql.mjs",
    "player-access:verify": "node scripts/verify-player-access-sql.mjs",
    "competition:generate": "node scripts/generate-competition-upgrade.mjs",
    "competition:verify": "node scripts/verify-competitive-sql.mjs",
    "sky-race:verify": "node scripts/verify-sky-race-sql.mjs",
    "assets:optimize": "node scripts/optimize-runtime-assets.mjs",
    "assets:icons": "node scripts/build-ui-icons.mjs",
    "assets:menu": "node scripts/build-menu-icons.mjs",
    "assets:equipment": "node scripts/build-equipment-icons.mjs",
    "assets:hero-actions": "node scripts/build-hero-actions.mjs",
    "assets:startup": "node scripts/build-startup-assets.mjs",
    "assets:verify": "node scripts/verify-runtime-assets.mjs",
    "build:ios": "node scripts/verify-runtime-assets.mjs && tsc -b && vite build --mode ios && node scripts/stage-android-assets.mjs ios",
    "ios:sync": "npm run build:ios && node scripts/capacitor-ios.mjs sync && node scripts/verify-ios-project.mjs",
    "ios:open": "node scripts/capacitor-ios.mjs open",
    "ios:run": "npm run ios:sync && node scripts/capacitor-ios.mjs run",
    "ios:verify": "node scripts/verify-ios-project.mjs",
    "ios:simulator": "node scripts/build-ios.mjs simulator",
    "ios:archive": "node scripts/build-ios.mjs archive"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@supabase/supabase-js": "^2.118.0",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@electric-sql/pglite": "0.5.12",
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
